AUTH_SECRET=replace-with-a-random-secret
# Used only by the scheduled graph-maintenance endpoint.
MAINTENANCE_SECRET=replace-with-an-independent-random-secret
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=replace-with-your-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-your-github-oauth-client-secret
AUTH_GOOGLE_ID=replace-with-your-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-your-google-oauth-client-secret
# Register /api/auth/callback/gmail on the same Google OAuth client.
AUTH_MICROSOFT_ENTRA_ID_ID=replace-with-your-microsoft-application-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-with-your-microsoft-client-secret
# Register /api/auth/callback/outlook, or optionally use a separate app below.
AUTH_OUTLOOK_ID=replace-with-your-outlook-oauth-client-id
AUTH_OUTLOOK_SECRET=replace-with-your-outlook-client-secret
MONGODB_URI=mongodb://pavucina:pavucina@localhost:27017/pavucina?authSource=admin

# Transfer limits in MiB; changing NEXT_PUBLIC values requires rebuilding the app.
NEXT_PUBLIC_MAX_MUTATION_MIB=10
NEXT_PUBLIC_MAX_SNAPSHOT_MIB=100
